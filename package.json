    "analyze:impact": "node scripts/analyze-impact.js",
    "analyze:diff": "node scripts/analyze-git-diff.js",
    "parsers:warm": "node scripts/warm-parsers.js"
  },
  "bin": {
    "changelens-ci": "./bin/changelens-ci.js"
  },
  "dependencies": {
    "@xberg-io/tree-sitter-language-pack-wasm": "1.22.1",
    "cors": "^2.8.6",
