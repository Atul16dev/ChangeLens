{
  "name": "changelens-parser-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "api": "node --watch api/server.js",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "ci:analyze": "node bin/changelens-ci.js",
    "analyze:sample": "node scripts/analyze-sample.js",
    "analyze:impact": "node scripts/analyze-impact.js",
    "analyze:diff": "node scripts/analyze-git-diff.js",
    "parsers:warm": "node scripts/warm-parsers.js",
    "db:view": "node scripts/db-inspector.js"
  },
  "bin": {
    "changelens-ci": "./bin/changelens-ci.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@xberg-io/tree-sitter-language-pack-wasm": "1.22.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "elkjs": "^0.12.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.1",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.7"
  }
}
