# ==============================================================================
# ChangeLens Environment Configuration Template
# Copy this file to .env and configure the values for your deployment
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Cloud Database (MongoDB Atlas)
# Recommended for production. If left empty, ChangeLens falls back to in-memory mode for dev/test.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/changelens?retryWrites=true&w=majority

# Cryptographic Session & OTP Secrets (Use cryptographically random 32+ byte strings)
SESSION_SECRET=changelens-production-session-secret-change-me-32-chars-minimum
OTP_SECRET=changelens-production-otp-hmac-secret-change-me-32-chars-minimum

# Transactional Email Service (SMTP)
# Use your Gmail address and 16-character App Password (smtp.gmail.com) or SendGrid/Resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="ChangeLens Security" <your-email@gmail.com>

# Google OAuth 2.0 Credentials (Optional)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Gemini AI Explainer Integration (Optional)
GEMINI_API_KEY=your-gemini-api-key
